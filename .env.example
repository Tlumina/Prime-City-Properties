# Prime City Properties Environment Configuration

# Django Core Settings
SECRET_KEY=django-insecure-prime-city-properties-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=primecity_db
DB_USER=primecity_user
DB_PASSWORD=primecity_secure_password
DB_HOST=localhost
DB_PORT=5432

# Media & Static Files Configuration
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Email Settings (for notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@primecityproperties.ng
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Prime City Properties <info@primecityproperties.ng>

# Company Contact Information
COMPANY_NAME=Prime City Properties
COMPANY_TAGLINE=Stop Searching. Start Living.
